<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/alan_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF000000</item>
        <item name="android:windowSplashScreenAnimationDuration">150</item>
        <!-- postSplashScreenTheme belongs to androidx.core:core-splashscreen, which this
             app does not use; Flutter switches to NormalTheme via the manifest meta-data. -->
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
